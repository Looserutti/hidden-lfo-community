VERIFIED_ROLE_ID=
RULES_CHANNEL_ID=
EVENTS_CHANNEL_ID=
STAFF_REPORT_CHANNEL_ID=
ADMIN_DISCORD_IDS=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback
SESSION_SECRET=replace-with-long-random-value
