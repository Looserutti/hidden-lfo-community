# Production: public DNS name pointing to your server (no scheme)
SITE_DOMAIN=community.example.com

# Optional outbound bot jobs; enable only after testing the destination channels.
EVENT_PUBLISHING_ENABLED=false
STAFF_REPORTS_ENABLED=false

# Two-step onboarding (off until roles/channel permissions are configured).
ONBOARDING_ENABLED=false
MEMBER_ROLE_ID=
INTRO_CHANNEL_ID=
