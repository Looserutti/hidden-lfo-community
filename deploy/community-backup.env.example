# Root-owned mode 0600. No credentials belong in Git.
RESTIC_REPOSITORY=/var/lib/community-backup/repository
RESTIC_PASSWORD_FILE=/etc/community-backup.password
APP_CURRENT=/opt/hidden-lfo/current
APP_CONTAINER=community-platform-web-1
BACKUP_STATE=/var/lib/community-backup
# For an off-server repository, use a restic-supported destination and export
# required provider credentials here. Keep the encryption password separately.

# After authorizing and initializing a Google Drive repository:
# RESTIC_REMOTE_REPOSITORY="rclone:community-drive:Community Hub Backups/restic"
# RCLONE_CONFIG=/etc/community-backup-rclone.conf
