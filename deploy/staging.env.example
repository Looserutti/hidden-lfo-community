# Copy to .env on the SERVER only. Preserve your Mac's local .env.
SITE_DOMAIN=preview.community.example.com
# Optional comma-prefixed aliases, e.g. ", www.community.example.com"
SITE_ALIASES=
PUBLIC_BASE_URL=https://preview.community.example.com
DISCORD_REDIRECT_URI=https://preview.community.example.com/auth/callback
SESSION_SECRET=replace-with-a-new-random-server-only-secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ADMIN_DISCORD_IDS=
DISCORD_INVITE_URL=
# Compose overrides this with its persistent /data database path.
DATABASE_URL=sqlite:////data/community.db
# Optional: leave blank for a website-only staging launch.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
VERIFIED_ROLE_ID=
RULES_CHANNEL_ID=
EVENTS_CHANNEL_ID=
STAFF_REPORT_CHANNEL_ID=
EVENT_PUBLISHING_ENABLED=false
STAFF_REPORTS_ENABLED=false

# Two-step onboarding (off until roles/channel permissions are configured).
ONBOARDING_ENABLED=false
MEMBER_ROLE_ID=
INTRO_CHANNEL_ID=
