# Copy to .env.preview on the server; do not copy the production database or bot token.
PREVIEW_IMAGE=your-community-preview:COMMIT
PROXY_NETWORK=community-platform_internal
SITE_DOMAIN=preview.community.example.com
PUBLIC_BASE_URL=https://preview.community.example.com
DISCORD_REDIRECT_URI=https://preview.community.example.com/auth/callback
SESSION_SECRET=replace-with-a-fresh-random-preview-only-secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ADMIN_DISCORD_IDS=
DISCORD_BOT_TOKEN=
EVENT_PUBLISHING_ENABLED=false
STAFF_REPORTS_ENABLED=false
SITE_ENVIRONMENT=preview

# Optional gallery audio: blank path uses persistent /data/gallery-audio in Docker.
GALLERY_AUDIO_DIR=
GALLERY_AUDIO_MAX_UPLOAD_MB=50
GALLERY_AUDIO_MAX_STORAGE_MB=512
